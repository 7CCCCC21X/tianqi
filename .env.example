# Do not commit a real token. Set these in Railway -> Variables.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# 0 means setup-only. Send /id to the running bot, then replace 0 with your user ID.
ADMIN_USER_ID=0
# Cities followed automatically: today + FOLLOW_DAYS days (each station's local date), one Predict market per day.
# Slug pattern: highest-temperature-in-{city}-on-{month}-{day}-{year}  (e.g. highest-temperature-in-shanghai-on-october-13-2026)
CITIES=shanghai
FOLLOW_DAYS=1
# A finished day's market stays followed this long after its local midnight (the settlement comes a few hours later).
KEEP_HOURS=30
# Extra markets by slug or URL (comma-separated), for a city that is not in CITIES or a day outside the window.
# MARKET_SLUGS=highest-temperature-in-shanghai-on-october-13-2026
# Station of each city: city=STATION:timezone:country[:lat,lon]. shanghai / hong-kong / beijing / tokyo / singapore / taipei are built in.
# The station the market rules name (timeseries?site=xxxx) is checked against this and used when the city is unknown.
# STATIONS=shanghai=ZSPD:Asia/Shanghai:CN:31.1434,121.8052;hong-kong=VHHH:Asia/Hong_Kong:HK
# Observation sources in order of trust: noaa = Synoptic API (the data behind the NOAA/NWS timeseries page the market
# settles on), metar = aviationweather.gov (the same METAR reports, read every cycle), wu = Weather Underground (the
# rules' fallback source). The newest METAR/Synoptic reading drives the alerts; disagreements are reported.
SOURCES=noaa,metar,wu
# Synoptic Data token (free at https://synopticdata.com/weatherapi/ -> account -> API tokens; the free tier allows 5,000
# requests a month). Empty = Synoptic's public demo token, which may stop working at any time.
SYNOPTIC_TOKEN=
# Weather Underground history page key (the public key embedded in wunderground.com is used when empty).
WU_API_KEY=
# Seconds between monitor cycles (METAR channel, alerts) / Synoptic reads / Weather Underground reads / orderbook reads.
POLL_SECONDS=60
NOAA_POLL_SECONDS=600
WU_POLL_SECONDS=900
PREDICT_POLL_SECONDS=20
# No new observation for this many minutes while the day runs -> a data notice (ZSPD reports every 30-60 minutes).
OBS_STALE_MINUTES=150
# Open-Meteo hourly forecast for the model probabilities (free, no key). off = no model, no edge alerts.
FORECAST=on
FORECAST_REFRESH_MINUTES=30
# Model error (°C) of the forecast peak at the start of the day; shrinks as the day runs out. FORECAST_BIAS is added
# to the forecast peak (airport METAR readings often sit a little under model peaks: try -0.3 after checking /obs).
FORECAST_SIGMA=1.2
FORECAST_BIAS=0
# Predict.fun orderbooks (read-only). PREDICT_API_KEY only if the REST API answers 401/403 (sent as x-api-key).
PREDICT=on
# PREDICT_API_KEY=
# Referral code appended to market links (?ref=); empty = none.
PREDICT_REF_CODE=B00EA
# Taker fee rate (bps) assumed when a market states none: Predict charges rate x min(p, 1-p) per share.
PREDICT_FEE_BPS=200
# Edge alerts: a bracket side whose net edge (model minus price minus fee) reaches EDGE_ALERT_CENTS, held for
# EDGE_ALERT_CONFIRM_SECONDS; the same market and side again only after EDGE_ALERT_COOLDOWN_SECONDS.
EDGE_ALERT=on
EDGE_ALERT_CENTS=10
EDGE_ALERT_CONFIRM_SECONDS=60
EDGE_ALERT_COOLDOWN_SECONDS=900
# Announce the day's maximum when it moves into another bracket (its first reading included) / a followed market the
# moment Predict lists it.
MAX_ALERT=on
NEW_MARKET_ALERT=on
# Requires a Railway Volume mounted at /data for persistence (observations, delivered alerts, subscriptions).
STATE_DB=/data/tianqi.sqlite3
