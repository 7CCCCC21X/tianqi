{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -u main.py",
    "restartPolicyType": "ALWAYS",
    "healthcheckPath": null,
    "overlapSeconds": "0",
    "drainingSeconds": "45"
  }
}
